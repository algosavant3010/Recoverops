# Copy to .env and fill in. Never commit .env.
# Google AI Studio (free tier): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Razorpay test-mode credentials (optional; mock adapter is used if absent).
# Dashboard → Settings → API Keys → Generate Test Key
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Runtime
RECOVEROPS_ENV=dev
RECOVEROPS_LOG_LEVEL=INFO
